# Copy this file to .env and fill in your values
# NEVER commit .env to version control

POSTGRES_PASSWORD=changeme_in_production

# These are auto-derived from POSTGRES_PASSWORD in docker-compose.yml
# Override here only if running outside Docker
# DATABASE_URL=postgresql+asyncpg://uitest:changeme@localhost:5432/uitestplatform
# SYNC_DATABASE_URL=postgresql+psycopg2://uitest:changeme@localhost:5432/uitestplatform

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

UPLOAD_DIR=/app/uploads
RESULTS_DIR=/app/results

# Optional tuning
MAX_UPLOAD_SIZE_BYTES=10485760   # 10 MB
PLAYWRIGHT_TIMEOUT_MS=25000
RUN_TIMEOUT_SECONDS=600
MAX_TEST_CASES=500
